{
  "name": "star-lists",
  "version": "0.1.0",
  "description": "把 GitHub 用户的 Star 项目按技术层级自动分类成多份 star list，可选同步为 GitHub Lists。",
  "type": "module",
  "bin": {
    "starlists": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx src/cli.ts --input fixtures/stars.demo.json --out out/demo",
    "starlists": "tsx src/cli.ts",
    "web": "node dist/web/server.js",
    "web:dev": "tsx src/web/server.ts"
  },
  "keywords": [
    "github",
    "stars",
    "star-lists",
    "categorize",
    "cli"
  ],
  "license": "MIT",
  "packageManager": "pnpm@12.11.2",
  "dependencies": {
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
